# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
USE_OPENAI_TTS=true
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# Voice: twilio = fast Polly neural (default) | openai = natural TTS (slower) | robotic = alice
VOICE_STYLE=twilio
USE_OPENAI_TTS=false
TWILIO_VOICE=Polly.Joanna-Neural
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=shimmer

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567
# Michael Kola / business owner (E.164)
TRANSFER_PHONE_NUMBER=+12404836963

# Database
# Local SQLite (default):
DATABASE_URL=sqlite:///./phone_agent.db
# Production Postgres (Supabase / Railway / Render):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# App
BASE_URL=https://your-ngrok-or-deployed-url.com
# Calendar — Google (recommended) or Calendly
# Provider: google | calendly | leave blank to auto-detect
CALENDAR_PROVIDER=google
CALENDAR_TIMEZONE=America/New_York
GOOGLE_CALENDAR_ID=your@gmail.com
# Option A: service account JSON file (local) OR paste full JSON (Railway)
GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json
# Railway: paste base64 of the JSON file (single line, avoids paste errors)
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Option B: OAuth refresh token (better for sending invite emails)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
APPOINTMENT_DURATION_MINUTES=30
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17

# Calendly (optional fallback)
CALENDLY_LINK=https://calendly.com/nm2tech77/nm2tech-ai-demo
CALENDLY_API_TOKEN=
CALENDLY_EVENT_TYPE_URI=
CALENDLY_TIMEZONE=America/New_York
DEBUG=false

# NM2TECH product URLs (optional — used when telling callers how to open an app)
NM2TECH_APPS_URL=https://nm2tech.com/apps
GUARDIAN_URL=
RECEIPTLENS_URL=
MEDSTAR_ER_URL=
WEBSITE_REVIEW_URL=
WORLD_CUP_URL=
TURTLE_DASH_URL=
LOCALAI_PRO_URL=

# Optional call greeting override (leave blank to use date-based / default greeting)
# EVENT_GREETING=Hello, and enjoy Olney National Night Out! Thanks for calling NM2TECH.
EVENT_GREETING=
